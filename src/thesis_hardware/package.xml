<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>thesis_hardware</name>
  <version>0.1.0</version>
  <description>
    Physical JACO2 orchestration and readiness checks for the thesis stack.
  </description>
  <maintainer email="a20216480@pucp.edu.pe">Luis Munoz</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>thesis_core</exec_depend>
  <exec_depend>thesis_description</exec_depend>
  <exec_depend>thesis_hardware_bridge</exec_depend>
  <exec_depend>thesis_interfaces</exec_depend>
  <exec_depend>thesis_ui</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
