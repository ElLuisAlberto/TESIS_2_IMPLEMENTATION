<?xml version="1.0"?>
<sdf version="1.8">
  <model name="safety_obstacle">
    <static>true</static>

    <link name="obstacle_link">
      <collision name="obstacle_collision">
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
      </collision>

      <visual name="obstacle_visual">
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.50 0.08 0.80 1.0</ambient>
          <diffuse>0.60 0.15 0.95 1.0</diffuse>
          <specular>0.30 0.30 0.30 1.0</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
